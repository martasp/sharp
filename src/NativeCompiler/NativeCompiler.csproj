<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Match the Roslyn 5.9.0 version used by the .NET 10 SDK analyzers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />

    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" GeneratePathProperty="true" PrivateAssets="all" />

  </ItemGroup>

  <!-- Locate SDK Analyzers Path -->
  <PropertyGroup>
    <_NativeCompilerTfmVersion>$(TargetFramework.Replace('net', ''))</_NativeCompilerTfmVersion>
    <!--
      Pin to the ref pack that ships with the SDK actually running the build. Globbing
      '$(_NativeCompilerTfmVersion).*' and joining the matches with ';' used to produce a single
      bogus HintPath whenever more than one matching ref pack was present (e.g. 10.0.9 and 10.0.12
      side by side), so all six SDK analyzer references silently failed to resolve and every
      `using Microsoft.Interop...` became CS0234. Glob order also picked an arbitrary version.
    -->
    <_NativeCompilerRefPackVersionDir>$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\$(BundledNETCoreAppPackageVersion)</_NativeCompilerRefPackVersionDir>
    <_NativeCompilerRefPackAnalyzersPath>$(_NativeCompilerRefPackVersionDir)\analyzers\dotnet\cs</_NativeCompilerRefPackAnalyzersPath>
  </PropertyGroup>

  <!-- Fail loudly instead of emitting MSB3245 warnings that cascade into CS0234. -->
  <Target Name="_NativeCompilerValidateRefPackAnalyzers" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(_NativeCompilerRefPackAnalyzersPath)')"
           Text="SDK analyzer path '$(_NativeCompilerRefPackAnalyzersPath)' does not exist. Expected the .NET $(BundledNETCoreAppPackageVersion) targeting pack under '$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref'. Run 'dotnet restore' first, or install the SDK matching TargetFramework $(TargetFramework)." />
  </Target>

  <!-- Expose SDK Analyzer DLLs as compile-time references -->
  <ItemGroup>
    <Reference Include="ILLink.RoslynAnalyzer" Private="true">
      <HintPath>$(PkgMicrosoft_NET_ILLink_Tasks)\analyzers\dotnet\cs\ILLink.RoslynAnalyzer.dll</HintPath>
    </Reference>
    <Reference Include="ILLink.CodeFixProvider" Private="true">
      <HintPath>$(PkgMicrosoft_NET_ILLink_Tasks)\analyzers\dotnet\cs\ILLink.CodeFixProvider.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.RegularExpressions.Generator" Private="true">
      <HintPath>$(_NativeCompilerRefPackAnalyzersPath)\System.Text.RegularExpressions.Generator.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Json.SourceGeneration" Private="true">
      <HintPath>$(_NativeCompilerRefPackAnalyzersPath)\System.Text.Json.SourceGeneration.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Interop.SourceGeneration" Private="true">
      <HintPath>$(_NativeCompilerRefPackAnalyzersPath)\Microsoft.Interop.SourceGeneration.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Interop.LibraryImportGenerator" Private="true">
      <HintPath>$(_NativeCompilerRefPackAnalyzersPath)\Microsoft.Interop.LibraryImportGenerator.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Interop.ComInterfaceGenerator" Private="true">
      <HintPath>$(_NativeCompilerRefPackAnalyzersPath)\Microsoft.Interop.ComInterfaceGenerator.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Interop.JavaScript.JSImportGenerator" Private="true">
      <HintPath>$(_NativeCompilerRefPackAnalyzersPath)\Microsoft.Interop.JavaScript.JSImportGenerator.dll</HintPath>
    </Reference>

    <!-- Microsoft.Extensions.DependencyModel ships only in the SDK (not the ref pack or shared
         framework). HintPath-copied like the analyzers above so the JIT self-host stays bindable,
         and so a `dotnet build` of this project copies it to bin/ exactly like the compiler does. -->
    <Reference Include="Microsoft.Extensions.DependencyModel" Private="true">
      <HintPath>$(MSBuildSDKsPath)\..\Microsoft.Extensions.DependencyModel.dll</HintPath>
    </Reference>

  </ItemGroup>

  <!-- Root System.SR::GetResourceString in analyzer assemblies so NativeAOT keeps their
       FxResources.<asm>.SR.resources manifest resources embedded (otherwise the inlineable-strings
       heuristic strips them and Roslyn's ResourceManager lookups throw MissingManifestResourceException). -->
  <ItemGroup>
    <IlcArg Include="--descriptor=$(MSBuildProjectDirectory)\AotAnalyzerResources.xml" />
  </ItemGroup>
  

</Project>