<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Match the Roslyn 5.9.0 version used by the .NET 10 SDK analyzers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
  </ItemGroup>

  <!-- Every SDK dependency the compiler binds - the targeting packs, the source generators, the
       ILLink analyzers, the apphost template, Microsoft.Extensions.DependencyModel, and the
       AnalyzerRegistry that statically constructs them - is owned by Dotnet10Dependencies. This
       project carries a single reference and no payload configuration of its own. -->
  <ItemGroup>
    <ProjectReference Include="..\Dotnet10Dependencies\Dotnet10Dependencies.csproj" />
  </ItemGroup>

  <!-- Root System.SR::GetResourceString in analyzer assemblies so NativeAOT keeps their
       FxResources.<asm>.SR.resources manifest resources embedded (otherwise the inlineable-strings
       heuristic strips them and Roslyn's ResourceManager lookups throw MissingManifestResourceException). -->
  <ItemGroup>
    <IlcArg Include="--descriptor=$(MSBuildProjectDirectory)\AotAnalyzerResources.xml" />
  </ItemGroup>

  <!-- The compile-time payload lives in its own assembly; see the note in Dotnet10Dependencies.
       `sharp` needs compile-time metadata (the targeting ref packs), the SDK source generators, the
       ILLink analyzers, the apphost template, and the *names* of the shared-framework assemblies. It
       used to read all of that from the installed SDK, so a machine without a .NET SDK could not use
       the compiler at all. Dotnet10Dependencies stages that payload at build time (tools/PayloadStager)
       and embeds its zip as a manifest resource of its own assembly; EmbeddedSdkRefs.cs extracts it to
       a version-keyed cache on first use. -->

</Project>
