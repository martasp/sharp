<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!--//dotnet publish -r win-x64 -c Release-->
    <!--<SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>-->

    <WarningsAsErrors>Nullable</WarningsAsErrors>

    <!-- PublishAot bakes IsDynamicCodeSupported=false into the runtimeconfig even for ordinary
         `dotnet build` + `dotnet NativeCompilerCLI.dll` (JIT) runs, killing the dynamic
         source-generator discovery that NativeAOT legitimately can't do but JIT can. Pin the
         SDK's DynamicCodeSupport host-option to true for managed builds; a real `dotnet publish`
         AOT flow (the SDK's _IsPublishing is set) re-applies the runtime's true capability itself. -->
    <DynamicCodeSupport Condition="'$(_IsPublishing)' != 'true'">true</DynamicCodeSupport>
  </PropertyGroup>

  <ItemGroup>
	  <ProjectReference Include="..\NativeCompiler\NativeCompiler.csproj" />
  </ItemGroup>

  <!-- PublishAot bakes IsDynamicCodeSupported=false into the runtimeconfig even for ordinary
       `dotnet build` + `dotnet NativeCompilerCLI.dll` (JIT) runs, killing the dynamic
       source-generator discovery that NativeAOT legitimately can't do but JIT can. Override the
       RuntimeHostConfigurationOption back to true for the managed build only. -->
  <ItemGroup Condition="'$(_IsPublishing)' != 'true'">
    <RuntimeHostConfigurationOption Update="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same descriptor as NativeCompiler so the CLI's own ILC run keeps analyzer resources embedded. -->
    <IlcArg Include="--descriptor=$(MSBuildProjectDirectory)\..\NativeCompiler\AotAnalyzerResources.xml" />
  </ItemGroup>

<ItemGroup>
    <!-- The ASP.NET Core targeting-pack generators that AnalyzerRegistry statically constructs
         (LoggerMessage, options, validation, config binding, and - for web projects - the minimal-API
         public Program).

         Repeated here because MSBuild does not flow HintPath <Reference> items from a referenced
         project into this app's deps.json, and AnalyzerRegistry binds those types when
         GetSourceGenerators() is first called. They cannot be hoisted into a shared .props either:
         sharp parses NativeCompiler.csproj as XML (CollectHintPathReferences) to resolve the same
         references when it compiles itself, so its copy has to stay inline. Same arrangement as
         M.E.DependencyModel in NativeCompilerTests.csproj. -->
    <Reference Include="Microsoft.AspNetCore.App.SourceGenerators" Private="true">
      <HintPath>$(NetCoreTargetingPackRoot)\Microsoft.AspNetCore.App.Ref\$(BundledNETCoreAppPackageVersion)\analyzers\dotnet\cs\Microsoft.AspNetCore.App.SourceGenerators.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Generators" Private="true">
      <HintPath>$(NetCoreTargetingPackRoot)\Microsoft.AspNetCore.App.Ref\$(BundledNETCoreAppPackageVersion)\analyzers\dotnet\cs\Microsoft.Extensions.Logging.Generators.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Options.SourceGeneration" Private="true">
      <HintPath>$(NetCoreTargetingPackRoot)\Microsoft.AspNetCore.App.Ref\$(BundledNETCoreAppPackageVersion)\analyzers\dotnet\cs\Microsoft.Extensions.Options.SourceGeneration.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Validation.ValidationsGenerator" Private="true">
      <HintPath>$(NetCoreTargetingPackRoot)\Microsoft.AspNetCore.App.Ref\$(BundledNETCoreAppPackageVersion)\analyzers\dotnet\cs\Microsoft.Extensions.Validation.ValidationsGenerator.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Configuration.Binder.SourceGeneration" Private="true">
      <HintPath>$(NetCoreTargetingPackRoot)\Microsoft.AspNetCore.App.Ref\$(BundledNETCoreAppPackageVersion)\analyzers\dotnet\cs\Microsoft.Extensions.Configuration.Binder.SourceGeneration.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
	  <!--<PackageReference Include="Cocona" Version="2.0.3" />-->
	  <!--<PackageReference Include="Cocona.Core" Version="2.0.3" />-->
	  <!--<PackageReference Include="Microsoft.DotNet.ILCompiler" Version="7.0.0-*"/>-->
  </ItemGroup>


</Project>

