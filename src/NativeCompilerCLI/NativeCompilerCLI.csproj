<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Host the CLI from the Microsoft-signed dotnet host instead of an unsigned apphost:
         this machine's code-integrity policy enforces enterprise signing on loads into
         unsigned processes, same exemption dotnet build relies on for csc/analyzers. -->
    <UseAppHost>false</UseAppHost>
	  <PublishAot>true</PublishAot>
    <!--//dotnet publish -r win-x64 -c Release-->
    <!--<SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>-->

    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
	  <ProjectReference Include="..\NativeCompiler\NativeCompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
	  <!--<PackageReference Include="Cocona" Version="2.0.3" />-->
	  <!--<PackageReference Include="Cocona.Core" Version="2.0.3" />-->
	  <!--<PackageReference Include="Microsoft.DotNet.ILCompiler" Version="7.0.0-*" />-->
  </ItemGroup>


</Project>

